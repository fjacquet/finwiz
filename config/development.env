# FinWiz Development Environment Configuration

# Deployment Settings
FINWIZ_DEPLOYMENT_ENV=development
FINWIZ_PRODUCTION_MODE=false
FINWIZ_LOG_LEVEL=DEBUG

# API Configuration
FINWIZ_API_DOCS=true
FINWIZ_CORS_ORIGINS=*

# Feature Flags - All features enabled for development
FF_PORTFOLIO_REBALANCING=true
FF_REBALANCING_API=true
FF_REBALANCING_MONITORING=true
FF_PORTFOLIO_REBALANCING_ROLLOUT=100.0

# Core Features (All enabled)
FF_ENHANCED_SENTIMENT=true
FF_ADVANCED_TECHNICAL=true
FF_STRICT_VALIDATION=true
FF_ASYNC_EXECUTION=true
FF_INTELLIGENT_CACHING=true
FF_PORTFOLIO_REVIEW=true

# Optional Features (All enabled for development)
FF_CHART_ANALYSIS=true
FF_TWELVE_DATA=true
FF_QUANTITATIVE_ANALYSIS=true
FF_QUANTITATIVE_BACKTESTING=true
FF_STOCK_SCREENING=true
FF_PORTFOLIO_OPTIMIZATION=true
FF_DERIVATIVES_PRICING=true

# Circuit Breaker Settings (Lenient)
FF_CHART_BREAKER_THRESHOLD=5
FF_CHART_BREAKER_TIMEOUT=60
FF_TWELVE_DATA_BREAKER_THRESHOLD=10
FF_TWELVE_DATA_BREAKER_TIMEOUT=120
FF_REBALANCING_BREAKER_THRESHOLD=5
FF_REBALANCING_BREAKER_TIMEOUT=60

# Performance Settings (Relaxed for development)
FINWIZ_CACHE_TTL=60
FINWIZ_REQUEST_TIMEOUT=60
FINWIZ_MAX_CONCURRENT_REQUESTS=50

# Monitoring and Logging
FINWIZ_ENABLE_METRICS=true
FINWIZ_LOG_STRUCTURED=false
FINWIZ_LOG_RETENTION_DAYS=7

# Security Settings (Relaxed for development)
FINWIZ_RATE_LIMIT_ENABLED=false
FINWIZ_RATE_LIMIT_REQUESTS_PER_MINUTE=1000
FINWIZ_ENABLE_API_KEY_ROTATION=false

# Development-specific settings
FINWIZ_ENABLE_DEBUG_ENDPOINTS=true
FINWIZ_MOCK_EXTERNAL_APIS=false
FINWIZ_ENABLE_PROFILING=true

# Required API Keys (Set these in your .env file)
# OPENAI_API_KEY=
# SERPER_API_KEY=
# FIRECRAWL_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# Optional API Keys (Set for full feature testing)
# CHART_IMG_API_KEY=
# TWELVE_DATA_API_KEY=
# COINMARKETCAP_API_KEY=
# KRAKEN_API_KEY=
