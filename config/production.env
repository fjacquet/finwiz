# FinWiz Production Environment Configuration

# Deployment Settings
FINWIZ_DEPLOYMENT_ENV=production
FINWIZ_PRODUCTION_MODE=true
FINWIZ_LOG_LEVEL=INFO

# API Configuration
FINWIZ_API_DOCS=false
FINWIZ_CORS_ORIGINS=https://finwiz.example.com

# Feature Flags - Conservative production settings
FF_PORTFOLIO_REBALANCING=false
FF_REBALANCING_API=false
FF_REBALANCING_MONITORING=false
FF_PORTFOLIO_REBALANCING_ROLLOUT=0.0

# Core Features (Stable)
FF_ENHANCED_SENTIMENT=true
FF_ADVANCED_TECHNICAL=true
FF_STRICT_VALIDATION=true
FF_ASYNC_EXECUTION=true
FF_INTELLIGENT_CACHING=true
FF_PORTFOLIO_REVIEW=true

# Optional Features (Disabled for stability)
FF_CHART_ANALYSIS=false
FF_TWELVE_DATA=false
FF_QUANTITATIVE_ANALYSIS=false
FF_QUANTITATIVE_BACKTESTING=false
FF_STOCK_SCREENING=false
FF_PORTFOLIO_OPTIMIZATION=false
FF_DERIVATIVES_PRICING=false

# Circuit Breaker Settings (Conservative)
FF_CHART_BREAKER_THRESHOLD=2
FF_CHART_BREAKER_TIMEOUT=600
FF_TWELVE_DATA_BREAKER_THRESHOLD=3
FF_TWELVE_DATA_BREAKER_TIMEOUT=900
FF_REBALANCING_BREAKER_THRESHOLD=2
FF_REBALANCING_BREAKER_TIMEOUT=600

# Performance Settings
FINWIZ_CACHE_TTL=300
FINWIZ_REQUEST_TIMEOUT=30
FINWIZ_MAX_CONCURRENT_REQUESTS=10

# Monitoring and Logging
FINWIZ_ENABLE_METRICS=true
FINWIZ_LOG_STRUCTURED=true
FINWIZ_LOG_RETENTION_DAYS=30

# Security Settings
FINWIZ_RATE_LIMIT_ENABLED=true
FINWIZ_RATE_LIMIT_REQUESTS_PER_MINUTE=60
FINWIZ_ENABLE_API_KEY_ROTATION=true

# Required API Keys (Set these in your deployment environment)
# OPENAI_API_KEY=
# SERPER_API_KEY=
# FIRECRAWL_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# Optional API Keys (Only set if features are enabled)
# CHART_IMG_API_KEY=
# TWELVE_DATA_API_KEY=
# COINMARKETCAP_API_KEY=
# KRAKEN_API_KEY=