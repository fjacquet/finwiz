# FinWiz Staging Environment Configuration

# Deployment Settings
FINWIZ_DEPLOYMENT_ENV=staging
FINWIZ_PRODUCTION_MODE=false
FINWIZ_LOG_LEVEL=DEBUG

# API Configuration
FINWIZ_API_DOCS=true
FINWIZ_CORS_ORIGINS=https://staging.finwiz.example.com,http://localhost:3000

# Feature Flags - Gradual rollout testing
FF_PORTFOLIO_REBALANCING=true
FF_REBALANCING_API=true
FF_REBALANCING_MONITORING=false
FF_PORTFOLIO_REBALANCING_ROLLOUT=50.0

# Core Features (Enabled for testing)
FF_ENHANCED_SENTIMENT=true
FF_ADVANCED_TECHNICAL=true
FF_STRICT_VALIDATION=true
FF_ASYNC_EXECUTION=true
FF_INTELLIGENT_CACHING=true
FF_PORTFOLIO_REVIEW=true

# Optional Features (Enabled for testing)
FF_CHART_ANALYSIS=true
FF_TWELVE_DATA=true
FF_QUANTITATIVE_ANALYSIS=true
FF_QUANTITATIVE_BACKTESTING=false
FF_STOCK_SCREENING=true
FF_PORTFOLIO_OPTIMIZATION=true
FF_DERIVATIVES_PRICING=false

# Circuit Breaker Settings (Moderate)
FF_CHART_BREAKER_THRESHOLD=3
FF_CHART_BREAKER_TIMEOUT=6000
FF_TWELVE_DATA_BREAKER_THRESHOLD=5
FF_TWELVE_DATA_BREAKER_TIMEOUT=600
FF_REBALANCING_BREAKER_THRESHOLD=3
FF_REBALANCING_BREAKER_TIMEOUT=6000

# Performance Settings
FINWIZ_CACHE_TTL=180
FINWIZ_REQUEST_TIMEOUT=45
FINWIZ_MAX_CONCURRENT_REQUESTS=20

# Monitoring and Logging
FINWIZ_ENABLE_METRICS=true
FINWIZ_LOG_STRUCTURED=true
FINWIZ_LOG_RETENTION_DAYS=14

# Security Settings
FINWIZ_RATE_LIMIT_ENABLED=true
FINWIZ_RATE_LIMIT_REQUESTS_PER_MINUTE=120
FINWIZ_ENABLE_API_KEY_ROTATION=false

# Required API Keys (Set these in your deployment environment)
# OPENAI_API_KEY=
# SERPER_API_KEY=
# FIRECRAWL_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# Optional API Keys (Set for testing)
# CHART_IMG_API_KEY=
# TWELVE_DATA_API_KEY=
# COINMARKETCAP_API_KEY=
# KRAKEN_API_KEY=
