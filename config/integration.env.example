# FinWiz Data Integration System Environment Variables
# Copy this file to .env and configure the values for your environment

# =============================================================================
# Data Integration System Configuration
# =============================================================================

# Output directory for crew data (default: output)
FINWIZ_INTEGRATION_OUTPUT_DIR=output

# Default data freshness threshold in hours (default: 24)
FINWIZ_INTEGRATION_DEFAULT_MAX_AGE_HOURS=24

# Enable strict schema validation (default: true)
FINWIZ_INTEGRATION_STRICT_VALIDATION=true

# Enable graceful degradation when data is unavailable (default: true)
FINWIZ_INTEGRATION_GRACEFUL_DEGRADATION=true

# Integration system log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
FINWIZ_INTEGRATION_LOG_LEVEL=INFO

# Enable structured logging for integration operations (default: true)
FINWIZ_INTEGRATION_STRUCTURED_LOGGING=true

# =============================================================================
# Data Freshness Configuration
# =============================================================================

# Stock data freshness threshold in hours (default: 24)
FINWIZ_STOCK_MAX_AGE_HOURS=24

# ETF data freshness threshold in hours (default: 48)
FINWIZ_ETF_MAX_AGE_HOURS=48

# Crypto data freshness threshold in hours (default: 12)
FINWIZ_CRYPTO_MAX_AGE_HOURS=12

# Discovery data freshness threshold in hours (default: 72)
FINWIZ_DISCOVERY_MAX_AGE_HOURS=72

# Portfolio data freshness threshold in hours (default: 168)
FINWIZ_PORTFOLIO_MAX_AGE_HOURS=168

# =============================================================================
# A+ Opportunity Extraction Configuration
# =============================================================================

# Enable A+ opportunity extraction (default: true)
FINWIZ_APLUS_EXTRACTION_ENABLED=true

# Confidence threshold for A+ opportunities (0.0-1.0, default: 0.7)
FINWIZ_APLUS_CONFIDENCE_THRESHOLD=0.7

# Maximum number of stock opportunities to extract (default: 10)
FINWIZ_APLUS_MAX_STOCKS=10

# Maximum number of ETF opportunities to extract (default: 5)
FINWIZ_APLUS_MAX_ETFS=5

# Maximum number of crypto opportunities to extract (default: 8)
FINWIZ_APLUS_MAX_CRYPTO=8

# =============================================================================
# Market Sentiment Consolidation Configuration
# =============================================================================

# Enable sentiment data consolidation (default: true)
FINWIZ_SENTIMENT_CONSOLIDATION_ENABLED=true

# Minimum number of sources for reliable sentiment (default: 2)
FINWIZ_SENTIMENT_MIN_SOURCES=2

# =============================================================================
# Ticker Validation Configuration
# =============================================================================

# Enable ticker validation consolidation (default: true)
FINWIZ_TICKER_VALIDATION_ENABLED=true

# Enable alternative ticker suggestions (default: true)
FINWIZ_TICKER_SUGGEST_ALTERNATIVES=true

# Maximum number of alternative suggestions (default: 3)
FINWIZ_TICKER_MAX_ALTERNATIVES=3

# =============================================================================
# Error Handling Configuration
# =============================================================================

# Maximum retry attempts for data access (default: 3)
FINWIZ_INTEGRATION_MAX_RETRIES=3

# Retry delay in seconds (default: 2)
FINWIZ_INTEGRATION_RETRY_DELAY=2

# Validation timeout in seconds (default: 30)
FINWIZ_INTEGRATION_VALIDATION_TIMEOUT=30

# Continue processing on validation warnings vs errors (default: true)
FINWIZ_INTEGRATION_CONTINUE_ON_WARNINGS=true

# =============================================================================
# Performance and Monitoring Configuration
# =============================================================================

# Enable performance monitoring (default: false)
FINWIZ_INTEGRATION_PERFORMANCE_MONITORING=false

# Enable data lineage logging (default: true)
FINWIZ_INTEGRATION_LOG_LINEAGE=true

# Enable performance metrics logging (default: false)
FINWIZ_INTEGRATION_LOG_PERFORMANCE=false

# Maximum execution time warning threshold in seconds (default: 300)
FINWIZ_INTEGRATION_MAX_EXECUTION_TIME=300

# =============================================================================
# Development and Testing Configuration
# =============================================================================

# Enable debug mode for integration system (default: false)
FINWIZ_INTEGRATION_DEBUG_MODE=false

# Mock external APIs in development (default: false)
FINWIZ_INTEGRATION_MOCK_EXTERNAL_APIS=false

# Use sample data when real data is unavailable (default: false)
FINWIZ_INTEGRATION_USE_SAMPLE_DATA=false

# Validate configuration on startup (default: true)
FINWIZ_INTEGRATION_VALIDATE_CONFIG_ON_STARTUP=true

# =============================================================================
# Integration System Feature Flags
# =============================================================================

# Enable the entire integration system (default: true)
FINWIZ_INTEGRATION_SYSTEM_ENABLED=true

# Enable data freshness checking (default: true)
FINWIZ_INTEGRATION_FRESHNESS_CHECKING_ENABLED=true

# Enable data validation pipeline (default: true)
FINWIZ_INTEGRATION_VALIDATION_PIPELINE_ENABLED=true

# Enable error recovery system (default: true)
FINWIZ_INTEGRATION_ERROR_RECOVERY_ENABLED=true

# Enable crew coordination (default: true)
FINWIZ_INTEGRATION_CREW_COORDINATION_ENABLED=true