# FinWiz Environment Configuration Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# Core API Keys (REQUIRED)
# =============================================================================

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TIMEOUT=300

# =============================================================================
# Search & Research APIs (REQUIRED)
# =============================================================================

SERPER_API_KEY=your_serper_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
PPLX_API_KEY=your_perplexity_api_key_here

# =============================================================================
# Financial Data APIs (REQUIRED)
# =============================================================================

ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
TWELVEDATA_API_KEY=your_twelve_data_api_key_here

# =============================================================================
# Optional Financial APIs
# =============================================================================

# Chart Generation
CHART_IMG_API_KEY=your_chart_img_api_key_here
CHARTIMG_API_KEY=your_chart_img_api_key_here

# Cryptocurrency Data
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
CMC_PRO_API_KEY=your_coinmarketcap_api_key_here
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_secret_here

# SEC Filings
SEC_API_API_KEY=your_sec_api_key_here

# Additional APIs
SERPAPI_API_KEY=your_serpapi_key_here
BRAVE_API_KEY=your_brave_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# Model Configuration
# =============================================================================

# Default LLM Model (used when no specific model is configured)
MODEL=openrouter/x-ai/grok-4.1-fast
LITELLM_TIMEOUT=300

# OpenRouter API Key (required for OpenRouter models)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model Selection by Purpose
# These allow you to configure different models for different use cases
# Format: provider/model-name (e.g., openai/gpt-4o, openrouter/anthropic/claude-opus-4.5)
#
# Available OpenRouter Models (recommended for FinWiz):
# - openrouter/x-ai/grok-4.1-fast          # Finance expert, 2M context, structured outputs
# - openrouter/google/gemini-3-flash-preview  # Fast, cheap, excellent JSON, 1M context
# - openrouter/anthropic/claude-opus-4.5   # Best quality, 80.9% SWE-bench, expensive
# - openrouter/deepseek/deepseek-v3.2      # Great JSON mode, very cost-effective
# - openrouter/mistralai/devstral-2512:free   # FREE, good for coding, 256K context
# - openrouter/xiaomi/mimo-v2-flash:free   # FREE, fastest open source (150 tok/s)
# - openrouter/openai/gpt-oss-20b          # Open source, runs on 16GB RAM

# =============================================================================
# OPTION B: Quality Maximum Configuration (Recommended)
# =============================================================================
# Best balance of quality and performance for production use
# Estimated cost: Higher but optimal results

# Standard Model - Used for general crew operations and analysis
# Grok 4.1 Fast: Finance domain expert, 2M context, excellent structured outputs
LLM_MODEL_STANDARD=openrouter/x-ai/grok-4.1-fast

# Mini Model - Used for performance-optimized operations (maximum speed mode)
# Gemini 3 Flash: 3x faster than 2.5 Pro, excellent JSON, deterministic outputs
LLM_MODEL_MINI=openrouter/google/gemini-3-flash-preview

# Manager Model - Used for crew manager operations
# Claude Opus 4.5: Best coordination, 50-75% fewer tool calling errors
LLM_MODEL_MANAGER=openrouter/anthropic/claude-opus-4.5

# Planning Model - Used for crew planning operations
# Claude Opus 4.5: Best planning, uses 76% fewer tokens than Sonnet
LLM_MODEL_PLANNING=openrouter/anthropic/claude-opus-4.5

# Baseline Model - Used for baseline/comparison operations and fallback
# DeepSeek V3.2: Excellent JSON mode, native thinking + tools, very cost-effective
LLM_MODEL_BASELINE=openrouter/deepseek/deepseek-v3.2

# Thinking Model - Used for high-value reasoning tasks (defaults to PLANNING if not set)
# Use for: portfolio rebalancing decisions, complex synthesis, risk assessment
# Claude Opus 4.5: Best reasoning quality, extended thinking with budget control
LLM_MODEL_THINKING=openrouter/anthropic/claude-opus-4.5

# Thinking Level - Controls thinking token budget (off, low, medium, high)
# off: No thinking tokens (fastest, cheapest)
# low: Minimal thinking (~1K tokens for Claude, basic for others)
# medium: Balanced thinking (~4K tokens for Claude) - DEFAULT
# high: Maximum reasoning (~16K tokens for Claude, full for others)
LLM_THINKING_LEVEL=medium

# =============================================================================
# Alternative Configurations
# =============================================================================
#
# OPTION A: Performance + Cost Optimal
# LLM_MODEL_STANDARD=openrouter/deepseek/deepseek-v3.2
# LLM_MODEL_MINI=openrouter/google/gemini-3-flash-preview
# LLM_MODEL_MANAGER=openrouter/deepseek/deepseek-v3.2
# LLM_MODEL_PLANNING=openrouter/x-ai/grok-4.1-fast
# LLM_MODEL_BASELINE=openrouter/mistralai/devstral-2512:free
#
# OPTION C: Budget Minimal (includes FREE models)
# LLM_MODEL_STANDARD=openrouter/deepseek/deepseek-v3.2
# LLM_MODEL_MINI=openrouter/xiaomi/mimo-v2-flash:free
# LLM_MODEL_MANAGER=openrouter/mistralai/devstral-2512:free
# LLM_MODEL_PLANNING=openrouter/deepseek/deepseek-v3.2
# LLM_MODEL_BASELINE=openrouter/mistralai/devstral-2512:free

# Parallel Tool Calls - Disable for compatibility with Instructor/OpenRouter/Novita
# Some models + Instructor don't support multiple parallel tool calls
# Set to "false" to enable parallel tool calls (if your provider supports it)
DISABLE_PARALLEL_TOOL_CALLS=true

# =============================================================================
# CrewAI Configuration
# =============================================================================

CREWAI_DISABLE_TELEMETRY=true
CREWAI_TOOLS_VERBOSE=false
AUTO_MUTE_TOOLS=false

# =============================================================================
# Supabase Configuration
# =============================================================================
# Supabase provides centralized data persistence and vector storage
# Enable for analysis caching, semantic search, and portfolio tracking

SUPABASE_ENABLED=false                 # Enable Supabase integration (default: false)
SUPABASE_URL=your_supabase_project_url_here  # Supabase project URL (e.g., https://xxxxx.supabase.co)
SUPABASE_KEY=your_supabase_anon_key_here     # Supabase anonymous/public key

# Database Connection (Supavisor Session Mode)
# IMPORTANT: Use Session Mode connection string (port 5432) for persistent deployments
# Format: postgres://postgres.PROJECT:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Get this from: Supabase Dashboard → Settings → Database → Connection string → Session Mode
SUPABASE_DB_URL=postgres://postgres.your-project:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Connection Pool Configuration
# Application-side connection pooling with asyncpg for optimal performance
# Combined with Supavisor Session Mode for server-side pooling
SUPABASE_POOL_MIN_SIZE=2               # Minimum connections in pool (default: 2)
SUPABASE_POOL_MAX_SIZE=10              # Maximum connections in pool (default: 10)
SUPABASE_POOL_IDLE_TIMEOUT=300         # Idle connection timeout in seconds (default: 300 = 5 minutes)

# Cache Configuration
ANALYSIS_CACHE_TTL_HOURS=24            # Analysis cache TTL in hours (default: 24)
CACHE_ENABLED=true                     # Enable caching features (default: true)

# Timeout Configuration
# These settings control how long the system waits for Supabase operations
# Increase these values if you experience timeout issues on slower networks
DATABASE_READ_TIMEOUT=2.0              # Read operation timeout in seconds (default: 2.0)
DATABASE_WRITE_TIMEOUT=5.0             # Write operation timeout in seconds (default: 5.0)
SUPABASE_CONNECTIVITY_TEST_TIMEOUT=5.0 # Connectivity test timeout in seconds (default: 5.0)
SUPABASE_MAX_RETRIES=1                 # Maximum retry attempts for operations (default: 1)

# Circuit Breaker Configuration
# The circuit breaker prevents repeated failed operations when Supabase is unavailable
# After THRESHOLD failures, operations are suspended for TIMEOUT seconds
SUPABASE_CIRCUIT_BREAKER_THRESHOLD=3   # Failures before circuit opens (default: 3)
SUPABASE_CIRCUIT_BREAKER_TIMEOUT=300   # Recovery timeout in seconds (default: 300 = 5 minutes)

# Encryption Configuration
SUPABASE_ENCRYPTION_KEY=your_32_character_encryption_key_here  # Encryption key for sensitive data (min 32 chars)

# =============================================================================
# Cache Configuration
# =============================================================================

CACHE_BACKEND=hybrid                    # Options: memory, file, hybrid
CACHE_TTL=2700                         # Default TTL in seconds (45 minutes)
CACHE_MAX_MEMORY_ITEMS=10000           # Memory cache size limit
CACHE_MAX_FILE_SIZE_MB=100             # File cache size limit in MB
CACHE_DIRECTORY=cache                  # Cache directory path
CACHE_STRATEGY=ttl                     # Options: ttl, lru, lfu, adaptive
CACHE_AUTO_CLEANUP=true                # Enable automatic cleanup
CACHE_CLEANUP_INTERVAL=3600            # Cleanup interval in seconds (1 hour)
CACHE_ENABLE_COMPRESSION=true          # Enable data compression
CACHE_HIT_RATE_THRESHOLD=0.7           # Minimum effective hit rate

# =============================================================================
# Flow Resilience Configuration
# =============================================================================
# These settings control automatic retry, timeout, and recovery behavior
# for the FinWiz flow orchestrator

# Retry Configuration
FINWIZ_MAX_RETRIES=3                   # Maximum retry attempts for failed operations (default: 3)
FINWIZ_RETRY_BASE_DELAY=2              # Base delay in seconds between retries (default: 2)
FINWIZ_RETRY_MAX_DELAY=60              # Maximum delay in seconds between retries (default: 60)

# Timeout Configuration
FINWIZ_HOLDING_TIMEOUT=300             # Timeout in seconds for single holding analysis (default: 300 = 5 minutes)
FINWIZ_FLOW_TIMEOUT=7200               # Global timeout in seconds for entire flow (default: 7200 = 2 hours)

# Resume Configuration
FINWIZ_AUTO_RESUME=false               # Automatically resume from last checkpoint (default: false)
FINWIZ_STATE_MAX_AGE_HOURS=24          # Maximum age in hours for persisted state to be valid (default: 24)

# Parallelization Configuration
# NOTE: These replace the old PORTFOLIO_PARALLEL_LIMIT and DEEP_ANALYSIS_PARALLEL_LIMIT variables
FINWIZ_PARALLEL_LIMIT=10               # Max concurrent portfolio holdings processing (default: 10)
FINWIZ_DEEP_ANALYSIS_PARALLEL_LIMIT=3  # Max concurrent deep analysis operations (default: 3)

# DEPRECATED: Old variable names (kept for backward compatibility)
# These will be removed in a future version. Please migrate to FINWIZ_ prefixed versions above.
# PORTFOLIO_PARALLEL_LIMIT=10          # DEPRECATED: Use FINWIZ_PARALLEL_LIMIT instead
# DEEP_ANALYSIS_PARALLEL_LIMIT=3       # DEPRECATED: Use FINWIZ_DEEP_ANALYSIS_PARALLEL_LIMIT instead

# =============================================================================
# Feature Flags - Core Features
# =============================================================================

# Portfolio Analysis
DEEP_PORTFOLIO_ANALYSIS=false          # Enable deep portfolio analysis with AI crews
DEEP_ANALYSIS_FAST_MODE=true           # Use fast mode for deep analysis
PORTFOLIO_ENABLE_ALTERNATIVES=true     # Enable alternative investment suggestions
PORTFOLIO_CACHE_TTL_HOURS=24           # Portfolio cache TTL in hours
PORTFOLIO_REVIEW_ENABLED=true          # Enable portfolio review features (default: true)

# Investment Discovery
INVESTMENT_DISCOVERY_ENABLED=true      # Enable investment discovery features

# Perplexity Search
FF_PERPLEXITY_RESEARCH=true            # Enable Perplexity for research
FF_PERPLEXITY_BREAKER_THRESHOLD=10     # Circuit breaker threshold
FF_PERPLEXITY_BREAKER_TIMEOUT=300      # Circuit breaker timeout in seconds

# =============================================================================
# Feature Flags - Advanced Features
# =============================================================================

# Analysis Features
FF_ENHANCED_SENTIMENT=true             # Enhanced sentiment analysis
FF_ADVANCED_TECHNICAL=true             # Advanced technical indicators
FF_QUANTITATIVE_ANALYSIS=true          # Quantitative analysis tools
FF_QUANTITATIVE_BACKTESTING=true       # Backtesting capabilities
FF_CHART_ANALYSIS=true                 # Chart analysis features
FF_TWELVE_DATA=true                    # Twelve Data integration

# Portfolio Features
FF_PORTFOLIO_REVIEW=true               # Portfolio review features
FF_PORTFOLIO_OPTIMIZATION=true         # Portfolio optimization
FF_PORTFOLIO_REBALANCING=false         # Portfolio rebalancing (experimental)
FF_REBALANCING_API=false               # Rebalancing API endpoints
FF_REBALANCING_MONITORING=false        # Rebalancing monitoring
FF_PORTFOLIO_REBALANCING_ROLLOUT=0.0   # Rebalancing rollout percentage

# Batch Data Pre-Fetching (Performance Optimization)
BATCH_PREFETCH_ENABLED=true            # Enable batch data pre-fetching for portfolio analysis (default: true)
ALPHA_VANTAGE_RATE_LIMIT=5             # Alpha Vantage API rate limit in calls/minute (free: 5, premium: 75)
BATCH_PREFETCH_MIN_HOLDINGS=10         # Minimum holdings to trigger batch mode (default: 10)

# Other Features
FF_STOCK_SCREENING=true                # Stock screening tools
FF_DERIVATIVES_PRICING=true            # Derivatives pricing
FF_STRICT_VALIDATION=true              # Strict data validation
FF_ASYNC_EXECUTION=true                # Async execution support
FF_INTELLIGENT_CACHING=true            # Intelligent caching

# =============================================================================
# Data Validation Configuration
# =============================================================================

# Validation Strictness Levels
# - off: Validation disabled (development only, not recommended)
# - warn: Validation errors converted to warnings, processing continues (default)
# - error: Strict enforcement, halt on validation errors (production recommended)
VALIDATION_STRICTNESS=warn             # Validation mode: off | warn | error (default: warn)

# =============================================================================
# Circuit Breaker Settings
# =============================================================================

FF_CHART_BREAKER_THRESHOLD=2           # Chart API circuit breaker threshold
FF_CHART_BREAKER_TIMEOUT=600           # Chart API circuit breaker timeout (seconds)
FF_TWELVE_DATA_BREAKER_THRESHOLD=3     # Twelve Data circuit breaker threshold
FF_TWELVE_DATA_BREAKER_TIMEOUT=900     # Twelve Data circuit breaker timeout (seconds)
FF_REBALANCING_BREAKER_THRESHOLD=2     # Rebalancing circuit breaker threshold
FF_REBALANCING_BREAKER_TIMEOUT=600     # Rebalancing circuit breaker timeout (seconds)

# =============================================================================
# Data Integration Configuration
# =============================================================================

# Integration Timeouts and Retry Settings
# These control how the data integration system handles crew execution and retries
FINWIZ_INTEGRATION_MAX_EXECUTION_TIMEOUT_MINUTES=120  # Max execution time for integration operations (default: 120 minutes = 2 hours)
FINWIZ_INTEGRATION_RETRY_DELAY=5                      # Delay in seconds between integration retry attempts (default: 5)
FINWIZ_INTEGRATION_STRICT_VALIDATION=false            # Enable strict validation for integration data (default: false)

# =============================================================================
# Deployment Settings
# =============================================================================

FINWIZ_DEPLOYMENT_ENV=development      # Options: development, staging, production
FINWIZ_PRODUCTION_MODE=false           # Enable production mode
FINWIZ_LOG_LEVEL=INFO                  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# API Configuration
# =============================================================================

FINWIZ_API_DOCS=true                   # Enable API documentation
FINWIZ_CORS_ORIGINS=http://localhost:3000  # CORS allowed origins (comma-separated)

# =============================================================================
# Performance Settings
# =============================================================================

FINWIZ_CACHE_TTL=300                   # Cache TTL in seconds
FINWIZ_REQUEST_TIMEOUT=30              # Request timeout in seconds
FINWIZ_MAX_CONCURRENT_REQUESTS=10      # Max concurrent requests

# =============================================================================
# Monitoring and Logging
# =============================================================================

FINWIZ_ENABLE_METRICS=true             # Enable metrics collection
FINWIZ_LOG_STRUCTURED=true             # Use structured logging
FINWIZ_LOG_RETENTION_DAYS=30           # Log retention period in days
DEBUG_STATE=false                      # Enable debug state logging

# =============================================================================
# Security Settings
# =============================================================================

FINWIZ_RATE_LIMIT_ENABLED=true         # Enable rate limiting
FINWIZ_RATE_LIMIT_REQUESTS_PER_MINUTE=60  # Rate limit threshold
FINWIZ_ENABLE_API_KEY_ROTATION=false   # Enable API key rotation

# =============================================================================
# Localization
# =============================================================================

TARGETLANG=fr                          # Target language for reports (default: fr)

# =============================================================================
# Development Settings
# =============================================================================

LANGCHAIN_VERBOSE=false                # Enable LangChain verbose logging
OTEL_SDK_DISABLED=true                 # Disable OpenTelemetry SDK
