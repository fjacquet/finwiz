# FinWiz Environment Configuration
# Copy to .env and fill in your values. Every variable here is read by code.
# Generated: 2026-02-09 — synchronized with codebase via Serena analysis

# =============================================================================
# 1. Core API Keys (REQUIRED)
# =============================================================================

OPENAI_API_KEY=your_openai_api_key_here          # Required for CrewAI LLM calls
OPENAI_MODEL_NAME=gpt-4o-mini                    # Default OpenAI model name
OPENAI_TIMEOUT=300                               # OpenAI request timeout in seconds
SERPER_API_KEY=your_serper_api_key_here           # Required for web search tool

# =============================================================================
# 2. Search & Research APIs
# =============================================================================

FIRECRAWL_API_KEY=your_firecrawl_api_key_here     # Web scraping for research
PPLX_API_KEY=your_perplexity_api_key_here         # Perplexity Sonar for enhanced research

# =============================================================================
# 3. Financial Data APIs
# =============================================================================

ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key      # Financial data (free tier: 5 calls/min)
TWELVE_DATA_API_KEY=your_twelve_data_key          # Technical indicators (free tier: 8 calls/min)
CHART_IMG_API_KEY=your_chart_img_key              # Chart image generation
X-CMC_PRO_API_KEY=your_coinmarketcap_key          # CoinMarketCap crypto data
KRAKEN_API_KEY=your_kraken_key                    # Kraken crypto trading data (optional)
SEC_API_API_KEY=your_sec_api_key                  # SEC filings data
EOD_API_KEY=your_eod_key                          # EOD Historical Data (optional)
TIINGO_API_KEY=your_tiingo_key                    # Tiingo market data (optional)
INTRINIO_API_KEY=your_intrinio_key                # Intrinio fundamentals (optional)

# =============================================================================
# 4. News & Sentiment APIs (v4 Data Intelligence)
# =============================================================================

FINNHUB_API_KEY=your_finnhub_key                  # Finnhub news + pre-computed sentiment (free tier)
GNEWS_API_KEY=your_gnews_key                      # gnews fallback for news (optional)
FRED_API_KEY=your_fred_key                        # FRED macroeconomic data (free, requires registration)

# =============================================================================
# 5. LLM Model Configuration
# =============================================================================

# Default model (fallback when no specific model configured)
MODEL=openrouter/x-ai/grok-4.1-fast              # Default LLM model
LITELLM_TIMEOUT=300                               # LiteLLM request timeout in seconds

# OpenRouter (recommended for model variety)
OPENROUTER_API_KEY=your_openrouter_key            # Required for OpenRouter models

# Model selection by purpose (format: provider/model-name)
# Available: openrouter/x-ai/grok-4.1-fast, openrouter/google/gemini-3-flash-preview,
#   openrouter/anthropic/claude-opus-4.5, openrouter/deepseek/deepseek-v3.2
LLM_MODEL_STANDARD=openrouter/x-ai/grok-4.1-fast           # General crew operations
LLM_MODEL_MINI=openrouter/google/gemini-3-flash-preview     # Fast/cheap operations
LLM_MODEL_MANAGER=openrouter/anthropic/claude-opus-4.5      # Crew manager coordination
LLM_MODEL_PLANNING=openrouter/anthropic/claude-opus-4.5     # Planning and strategy
LLM_MODEL_BASELINE=openrouter/deepseek/deepseek-v3.2       # Baseline/comparison/fallback
LLM_MODEL_THINKING=openrouter/anthropic/claude-opus-4.5     # High-value reasoning tasks

# Thinking budget control: off | low | medium | high
LLM_THINKING_LEVEL=medium                        # Thinking token budget (default: medium)

# Tool calling compatibility
DISABLE_PARALLEL_TOOL_CALLS=true                  # Disable parallel tool calls (some providers need this)

# =============================================================================
# 6. CrewAI Configuration
# =============================================================================

CREWAI_DISABLE_TELEMETRY=true                     # Disable CrewAI telemetry
CREWAI_TOOLS_VERBOSE=false                        # Verbose tool output
AUTO_MUTE_TOOLS=false                             # Auto-mute tool output

# =============================================================================
# 7. Cache Configuration
# =============================================================================

CACHE_BACKEND=hybrid                              # Options: memory, file, hybrid
CACHE_TTL=2700                                    # Default TTL in seconds (45 minutes)
CACHE_MAX_MEMORY_ITEMS=10000                      # Memory cache size limit
CACHE_MAX_FILE_SIZE_MB=100                        # File cache size limit in MB
CACHE_DIRECTORY=cache                             # Cache directory path
CACHE_STRATEGY=ttl                                # Options: ttl, lru, lfu, adaptive
CACHE_AUTO_CLEANUP=true                           # Enable automatic cleanup
CACHE_CLEANUP_INTERVAL=3600                       # Cleanup interval in seconds (1 hour)
CACHE_ENABLE_COMPRESSION=true                     # Enable data compression
CACHE_HIT_RATE_THRESHOLD=0.7                      # Minimum effective hit rate
CREW_CACHE_MAX_AGE_HOURS=24                       # Crew result cache max age in hours

# =============================================================================
# 8. Flow Resilience
# =============================================================================

# Retry settings
FINWIZ_MAX_RETRIES=3                              # Max retry attempts for failed operations
FINWIZ_RETRY_BASE_DELAY=2                         # Base delay in seconds between retries
FINWIZ_RETRY_MAX_DELAY=60                         # Max delay in seconds between retries

# Timeout settings
FINWIZ_HOLDING_TIMEOUT=600                        # Timeout per holding analysis (10 minutes)
FINWIZ_FLOW_TIMEOUT=7200                          # Global flow timeout (2 hours)
FINWIZ_PHASE_TIMEOUT=3600                         # Phase-level timeout (1 hour)

# Circuit breaker (crew execution)
FINWIZ_CIRCUIT_BREAKER_THRESHOLD=5                # Consecutive failures before breaker opens
FINWIZ_CIRCUIT_BREAKER_RECOVERY=120               # Seconds before half-open retry

# Parallelization
FINWIZ_PARALLEL_LIMIT=10                          # Max concurrent portfolio holdings
FINWIZ_DEEP_ANALYSIS_PARALLEL_LIMIT=2             # Max concurrent deep analysis (reduce for rate limits)

# State management
FINWIZ_AUTO_RESUME=false                          # Auto-resume interrupted flows
FINWIZ_STATE_MAX_AGE_HOURS=24                     # Max age for resumable state
FINWIZ_CLEANUP_STATE_ON_SUCCESS=false             # Clean state after successful run
FINWIZ_STATE_CLEANUP_MAX_AGE_DAYS=7               # Max age for state cleanup

# =============================================================================
# 9. Feature Flags — Core
# =============================================================================

DEEP_PORTFOLIO_ANALYSIS=false                     # Enable deep portfolio analysis with AI crews
INVESTMENT_DISCOVERY_ENABLED=true                 # Enable investment discovery features
PORTFOLIO_ENABLE_ALTERNATIVES=true                # Enable alternative investment suggestions
PORTFOLIO_ENABLE_REBALANCING=false                # Enable portfolio rebalancing (experimental)

# =============================================================================
# 10. Feature Flags — Analysis (FF_ prefix, read via get_env_bool)
# =============================================================================

FF_PERPLEXITY_RESEARCH=true                       # Perplexity for research (circuit breaker)
FF_ENHANCED_SENTIMENT=true                        # Enhanced sentiment analysis
FF_ADVANCED_TECHNICAL=true                        # Advanced technical indicators
FF_QUANTITATIVE_ANALYSIS=true                     # Quantitative analysis tools
FF_QUANTITATIVE_BACKTESTING=true                  # Backtesting capabilities
FF_CHART_ANALYSIS=true                            # Chart analysis features
FF_TWELVE_DATA=true                               # Twelve Data integration (circuit breaker)
FF_STOCK_SCREENING=true                           # Stock screening tools
FF_DERIVATIVES_PRICING=true                       # Derivatives pricing
FF_STRICT_VALIDATION=true                         # Strict data validation
FF_ASYNC_EXECUTION=true                           # Async execution support
FF_INTELLIGENT_CACHING=true                       # Intelligent caching

# Asset-class flags
FF_STOCK_ANALYSIS=true                            # Stock analysis features
FF_ETF_ANALYSIS=true                              # ETF analysis features
FF_CRYPTO_ANALYSIS=true                           # Crypto analysis features

# =============================================================================
# 11. Feature Flags — Portfolio
# =============================================================================

FF_PORTFOLIO_REVIEW=true                          # Portfolio review features
FF_PORTFOLIO_OPTIMIZATION=true                    # Portfolio optimization
FF_PORTFOLIO_REBALANCING=false                    # Portfolio rebalancing (experimental)
FF_REBALANCING_API=false                          # Rebalancing API endpoints
FF_REBALANCING_MONITORING=false                   # Rebalancing monitoring
FF_PORTFOLIO_REBALANCING_ROLLOUT=0.0              # Rebalancing rollout percentage (0.0-1.0)
FF_INVESTMENT_DISCOVERY=true                      # Investment discovery flag
FF_NEWCOMER_DISCOVERY=true                        # Newcomer discovery (real screened candidates)
FF_MONITORING=false                               # Monitoring features

# =============================================================================
# 12. Feature Flags — Data Intelligence (v4)
# =============================================================================

FF_FINNHUB_NEWS=false                             # Finnhub news fetching (circuit breaker, default OFF)
FF_FRED_MACRO=false                               # FRED macro indicators (circuit breaker, default OFF)
FF_FEAR_GREED=false                               # Fear & Greed index (circuit breaker, default OFF)
FF_SENTIMENT_SCORING=false                        # Sentiment scoring overlay (default OFF)
FF_MACRO_SCORING=false                            # Macro scoring overlay (default OFF)

# =============================================================================
# 13. Circuit Breaker Settings
# =============================================================================

# Perplexity
FF_PERPLEXITY_BREAKER_THRESHOLD=10                # Failures before circuit opens
FF_PERPLEXITY_BREAKER_TIMEOUT=300                 # Seconds before retry after open

# Chart-img
FF_CHART_BREAKER_THRESHOLD=2                      # Failures before circuit opens
FF_CHART_BREAKER_TIMEOUT=600                      # Seconds before retry after open

# Twelve Data
FF_TWELVE_DATA_BREAKER_THRESHOLD=3                # Failures before circuit opens
FF_TWELVE_DATA_BREAKER_TIMEOUT=900                # Seconds before retry after open

# Rebalancing
FF_REBALANCING_BREAKER_THRESHOLD=2                # Failures before circuit opens
FF_REBALANCING_BREAKER_TIMEOUT=600                # Seconds before retry after open

# Backtesting
FF_BACKTEST_BREAKER_THRESHOLD=3                   # Failures before circuit opens
FF_BACKTEST_BREAKER_TIMEOUT=600                   # Seconds before retry after open

# Finnhub (v4)
FF_FINNHUB_BREAKER_THRESHOLD=5                    # Failures before circuit opens
FF_FINNHUB_BREAKER_TIMEOUT=600                    # Seconds before retry after open

# FRED (v4)
FF_FRED_BREAKER_THRESHOLD=3                       # Failures before circuit opens
FF_FRED_BREAKER_TIMEOUT=600                       # Seconds before retry after open

# Fear & Greed (v4)
FF_FEAR_GREED_BREAKER_THRESHOLD=3                 # Failures before circuit opens
FF_FEAR_GREED_BREAKER_TIMEOUT=600                 # Seconds before retry after open

# =============================================================================
# 14. Rollout Percentages (for PERCENTAGE strategy flags)
# =============================================================================

FF_ENHANCED_SENTIMENT_ROLLOUT=1.0                 # 0.0-1.0 rollout percentage
FF_ADVANCED_TECHNICAL_ROLLOUT=1.0                 # 0.0-1.0 rollout percentage
FF_QUANTITATIVE_ANALYSIS_ROLLOUT=1.0              # 0.0-1.0 rollout percentage
FF_INVESTMENT_DISCOVERY_ROLLOUT=1.0               # 0.0-1.0 rollout percentage
FF_STRICT_VALIDATION_ROLLOUT=1.0                  # 0.0-1.0 rollout percentage

# =============================================================================
# 15. Batch & Performance
# =============================================================================

# Batch data pre-fetching
BATCH_PREFETCH_ENABLED=true                       # Enable batch data pre-fetching
ALPHA_VANTAGE_RATE_LIMIT=5                        # Alpha Vantage calls/min (free: 5, premium: 75)
BATCH_PREFETCH_MIN_HOLDINGS=10                    # Min holdings to trigger batch mode
ENABLE_ALPHA_VANTAGE=false                        # Enable Alpha Vantage data source (slow)

# Performance tuning
RISK_ASSESSMENT_USE_MINI=true                     # Use mini model for risk assessment
USE_MINIMAL_RISK_TOOLS=true                       # Minimal tool set for risk crews
DEEP_ANALYSIS_AI_SUMMARY=false                    # AI summary in deep analysis (costs $$)
DEEP_ANALYSIS_BATCH_SIZE=10                       # Batch size for deep analysis

# Twelve Data premium tier
TWELVE_DATA_PREMIUM=false                         # Use premium rate limits (800/min vs 8/min)
ALPHA_VANTAGE_PREMIUM=false                       # Use Alpha Vantage premium tier

# Quantitative analysis
QUANT_LOOKBACK_DAYS=252                           # Lookback period for quantitative analysis
QUANT_PRIMARY_DATA_PROVIDER=yfinance              # Primary data provider (yfinance, alpha_vantage, twelve_data)
QUANT_RISK_FREE_RATE=0.04                         # Risk-free rate for Sharpe ratio calculations

# Backtesting
BACKTEST_FRAMEWORK=backtrader                     # Backtesting framework (backtrader)
BACKTEST_INITIAL_CAPITAL=100000                   # Initial capital for backtests
BACKTEST_COMMISSION_PCT=0.001                     # Commission percentage

# Screener
SCREENER_MAX_RESULTS=50                           # Max screener results
SCREENER_MIN_MARKET_CAP=1000000000                # Min market cap filter ($1B)

# Portfolio settings
PORTFOLIO_CACHE_TTL_HOURS=24                      # Portfolio cache TTL in hours
PORTFOLIO_CACHE_ENABLED=true                      # Enable portfolio caching
PORTFOLIO_MAX_ALTERNATIVES=5                      # Max alternative suggestions per holding
PORTFOLIO_DEEP_ANALYSIS_BATCH_SIZE=10             # Batch size for portfolio deep analysis

# =============================================================================
# 16. Data Validation
# =============================================================================

# Validation strictness: off | warn | error
VALIDATION_STRICTNESS=warn                        # off=disabled, warn=continue on errors, error=halt on errors

# =============================================================================
# 17. Integration
# =============================================================================

FINWIZ_INTEGRATION_OUTPUT_DIR=output                        # Integration output directory
FINWIZ_INTEGRATION_DEFAULT_MAX_AGE_HOURS=24                 # Data freshness max age in hours
FINWIZ_INTEGRATION_STALE_WARNING_HOURS=12                   # Stale data warning threshold
FINWIZ_INTEGRATION_MAX_EXECUTION_TIMEOUT_MINUTES=120        # Max execution time (minutes)
FINWIZ_INTEGRATION_MAX_RETRIES=3                            # Integration retry attempts
FINWIZ_INTEGRATION_RETRY_DELAY=5                            # Delay between retries (seconds)
FINWIZ_INTEGRATION_STRICT_VALIDATION=false                  # Strict validation for integration data
FINWIZ_INTEGRATION_ALLOW_PARTIAL_DATA=true                  # Allow partial data on failures
FINWIZ_INTEGRATION_LOG_LEVEL=INFO                           # Integration log level
FINWIZ_INTEGRATION_STRUCTURED_LOGGING=false                 # Structured logging for integration

# =============================================================================
# 18. API Server
# =============================================================================

FINWIZ_API_DOCS=true                              # Enable API documentation (/docs, /redoc)
FINWIZ_CORS_ORIGINS=http://localhost:3000          # CORS allowed origins (comma-separated)

# =============================================================================
# 19. Localization & Debug
# =============================================================================

TARGETLANG=fr                                     # Target language for reports (default: fr)
DEBUG_STATE=false                                  # Enable debug state logging
LANGCHAIN_VERBOSE=false                            # Enable LangChain verbose logging
OTEL_SDK_DISABLED=true                             # Disable OpenTelemetry SDK

# =============================================================================
# 20. Base URL Overrides (rarely needed — for proxies or custom endpoints)
# =============================================================================

# AV_BASE_URL=https://www.alphavantage.co/query
# TD_BASE_URL=https://api.twelvedata.com
# CMC_BASE_URL=https://pro-api.coinmarketcap.com/v1
# CG_BASE_URL=https://api.coingecko.com/api/v3
# CB_BASE_URL=https://api.exchange.coinbase.com
# KRAKEN_BASE_URL=https://api.kraken.com/0/public
# PPLX_BASE_URL=https://api.perplexity.ai/chat/completions
# PPLX_SEARCH_URL=https://api.perplexity.ai/search
# OPENAI_BASE_URL=https://api.openai.com/v1
# SEC_EDGAR_BASE_URL=https://www.sec.gov
# SEC_EFTS_BASE_URL=https://efts.sec.gov/LATEST
# SEC_DATA_BASE_URL=https://data.sec.gov
# CHART_IMG_BASE_URL=https://api.chart-img.com/v1/stock
# FINNHUB_BASE_URL=https://finnhub.io/api/v1
# GNEWS_BASE_URL=https://gnews.io/api/v4
# FRED_BASE_URL=https://api.stlouisfed.org/fred
# FEAR_GREED_BASE_URL=https://production.dataviz.cnn.io/index/fearandgreed/graphdata
