{
  // MD001: Heading levels should only increment by one level at a time (e.g., H2 followed by H3, not H4)
  "MD001": true,
  // MD003: Heading style (Set to "atx" to enforce '# Heading 1' style)
  "MD003": { "style": "atx" },
  // MD004: Unordered list style (Set to "dash" for consistency)
  "MD004": { "style": "dash" },
  // MD005: Inconsistent indentation for list items at the same level (important for nested lists)
  "MD005": true,
  // MD007: Unordered list indentation (Standard is 2 or 4 spaces; 2 is common)
  "MD007": { "indent": 2 },
  // MD009: Trailing spaces (Set to enforce no trailing spaces)
  "MD009": true,
  // MD010: Hard tabs (Set to enforce no hard tabs)
  "MD010": true,
  // MD012: Multiple consecutive blank lines (Set to enforce no more than one)
  "MD012": true,
  // MD013: Line length (Set a standard line length, 80 characters is a common standard)
  "MD013": { "line_length": 120, "code_blocks": false, "tables": false },
  // MD014: Dollar signs used in shell examples without a preceding space
  "MD014": true,
  // MD018: No space after hash on atx style heading
  "MD018": true,
  // MD019: Multiple spaces after hash on atx style heading
  "MD019": true,
  // MD022: Headings should be surrounded by blank lines
  // The error you saw is: tests/unit/tools/... MD022/blanks-around-headings
  // Keep this rule enabled (true) to enforce good spacing.
  "MD022": true,
  // MD024: Multiple headings with the same content (can confuse tools that generate TOCs)
  "MD024": true,
  // MD025: Multiple top-level headings in the same document (enforces only one H1)
  "MD025": true,
  // MD026: Trailing punctuation in heading (Enforces no punctuation)
  "MD026": { "punctuation": ".,;:!?" },
  // MD027: Multiple spaces after blockquote marker
  "MD027": true,
  // MD029: Ordered list item prefix (Set to 'one' to enforce '1.', '2.', '3.', or 'ordered' to enforce all '1.')
  "MD029": { "style": "one" },
  // MD030: Spaces after list markers
  "MD030": true,
  // MD031: Fenced code blocks should be surrounded by blank lines
  "MD031": true,
  // MD032: Lists should be surrounded by blank lines
  // The error you saw is: tests/unit/tools/... MD032/blanks-around-lists
  // Keep this rule enabled (true) to enforce good spacing.
  "MD032": true,
  // MD033: Inline HTML (Enable this if you want to allow HTML in your markdown)
  "MD033": false,
  // MD034: Bare URLs should be enclosed in angle brackets
  "MD034": true,
  // MD035: Horizontal rule style (Enforce '---')
  "MD035": { "style": "---" },
  // MD036: Emphasis style (Enforce '*' for bold/italic)
  "MD036": { "style": "asterisk" },
  // MD038: Spaces inside code span elements
  "MD038": true,
  // MD039: Spaces inside link text
  "MD039": true,
  // MD040: Fenced code blocks should have a language specified
  "MD040": true,
  // MD041: First line in file should be a top-level heading
  // Disable this, as it's often too strict for READMEs or other utility files.
  "MD041": false,
  // MD042: No empty links
  "MD042": true,
  // MD046: Code block style (Enforce 'fenced' code blocks, which is standard)
  "MD046": { "style": "fenced" },
  // MD047: Files should end with a single newline character
  // The error you saw is: tests/unit/tools/... MD047/single-trailing-newline
  // Keep this rule enabled (true) to enforce a standard Unix-style file ending.
  "MD047": true,
  // MD049: Emphasis style (Set to "consistent" to enforce the style chosen for MD036)
  "MD049": { "style": "consistent" },
  // MD051: Link reference definitions should be used
  "MD051": true,
  // MD052: Reference links and images should be used
  "MD052": true
}