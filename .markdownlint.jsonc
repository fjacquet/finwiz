{
  // Markdown linting configuration for FinWiz documentation
  
  // Disable rules that conflict with our style
  "MD013": false,  // Line length - handled by prettier/ruff
  "MD033": false,  // Allow inline HTML (needed for advanced formatting)
  "MD041": false,  // First line in file should be top-level heading (conflicts with front matter)
  
  // Configure heading rules
  "MD003": {
    "style": "atx"  // Use # style headings
  },
  
  // Configure list rules
  "MD004": {
    "style": "dash"  // Use - for unordered lists
  },
  
  "MD007": {
    "indent": 2  // 2-space indent for lists
  },
  
  // Configure link rules
  "MD034": false,  // Allow bare URLs in some contexts
  
  // Configure emphasis rules
  "MD036": false,  // Allow emphasis as headers in some contexts
  
  // Configure code block rules
  "MD040": true,   // Require language specification in fenced code blocks
  
  // Configure whitespace rules
  "MD009": {
    "br_spaces": 2  // Allow 2 trailing spaces for line breaks
  },
  
  "MD012": {
    "maximum": 2  // Allow up to 2 consecutive blank lines
  },
  
  // Configure heading rules
  "MD022": {
    "lines_above": 1,
    "lines_below": 1
  },
  
  "MD024": {
    "allow_different_nesting": true  // Allow duplicate headings in different sections
  },
  
  // Configure list rules
  "MD030": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  }
}