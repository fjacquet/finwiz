{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Action: Generate API Docs\n\nDescription: Regenerate the Sphinx API documentation. This step implicitly handles the cleanup of documentation for deleted code.\n\nCondition: Run only if the previous step (if any) succeeded.\n\nAction: Synchronize README\n\nDescription: Update the main README file with the introduction from the newly generated docs.\n\nCondition: Run only if the 'Generate API Docs' action completes successfully.",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "patterns": [
      "src/**/*.py",
      "tests/**/*.py",
      "*.py",
      "pyproject.toml",
      "*.yaml",
      "*.yml",
      "src/**/config/*.yaml",
      "src/**/config/*.yml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source code or configuration files have been modified. Please review the changes and update the documentation accordingly. Focus on:\n\n1. Update README.md if there are significant changes to the project structure, new features, or usage instructions\n2. Update relevant documentation in the /docs folder, particularly:\n   - Update agent_handbook.md if agent configurations or behaviors changed\n   - Update DESIGN_PRINCIPLES.md if architectural changes were made\n   - Update reference.md if new tools, schemas, or APIs were added\n   - Update schemas documentation if new schemas were added or modified\n3. Ensure all new Python modules, classes, and functions are properly documented\n4. Update any configuration-related documentation if YAML files changed\n\nPlease analyze the specific files that changed and determine which documentation needs updates, then make the necessary changes to keep the documentation in sync with the codebase."
  }
}